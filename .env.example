# Partner Program application backend — server-only secrets.
# Set these in BOTH Vercel projects: production (sinauraco-site) and the
# sinauraco-preview project. The route fails SAFE if any are missing — the
# application still returns 200, the team email is the backup record, and a
# missing key only logs a warning. Never commit real values.

# ── Notion (storage) ──────────────────────────────────────────────────────────
# One page per application in the "Partner Applications" database.
#   1) Create an internal integration → https://www.notion.so/my-integrations
#   2) Share the "Partner Applications" database with that integration
#   3) Paste the integration token + the database id below.
NOTION_TOKEN=
NOTION_DB_ID=

# ── Resend (team notification + applicant confirmation) ───────────────────────
# Verify sinauraco.com as a sending domain (SPF/DKIM on Cloudflare) before use.
RESEND_API_KEY=
PARTNER_FROM_EMAIL="Sinaura Collectives <partners@sinauraco.com>"
PARTNER_TEAM_EMAIL=contact@sinauraco.com
